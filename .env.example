# Copie para .env.local (dev) e cadastre na Vercel (Settings → Environment Variables).
# Nunca versione o .env.local. Depois de criar/trocar variável na Vercel: REDEPLOY.

# ---------- Públicas (vão para o navegador) ----------

# URL final do site, sem barra no fim (canonical, sitemap, Open Graph, Schema).
# O domínio sem www redireciona para o www: usar o www.
NEXT_PUBLIC_SITE_URL=https://www.paduaseguros.com.br

# WhatsApp da Pádua: DDI + DDD + número, só dígitos (ex.: 5511999999999)
# Se vazio, usa o número padrão de lib/site.ts
NEXT_PUBLIC_WHATSAPP_NUMBER=5562982294264

# Google Tag Manager (GA4, Google Ads e Meta Pixel são configurados DENTRO do GTM)
NEXT_PUBLIC_GTM_ID=GTM-MRMP8MT7
# Referência para o container do GTM (o site não carrega estes direto)
NEXT_PUBLIC_GA4_ID=G-NM41WZ5Y2C
NEXT_PUBLIC_META_PIXEL_ID=1100323236037100

# ---------- Secretas (só servidor: /api/*) ----------

# Banco do /dashboard (projeto Supabase compartilhado da M|P; tabelas padua_*)
SUPABASE_URL=https://khipnjfbxjgvmjvyxero.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # Supabase → Project Settings → API keys → service_role (secreta; nunca no front)

# API de Conversões da Meta (app/api/meta-lead): token gerado no Gerenciador de Eventos → Pixel → Configurações.
# Só envia em produção (VERCEL_ENV=production). META_CAPI_TEST_CODE (opcional) manda para "Eventos de teste",
# inclusive em preview; apagar depois de conferir. META_PIXEL_ID e META_GRAPH_VERSION têm padrão no código.
META_CAPI_TOKEN=
META_CAPI_TEST_CODE=
# Login do /dashboard
DASHBOARD_PASSWORD=                   # senha única do /dashboard (mín. 8 caracteres)
DASHBOARD_SECRET=                     # string aleatória longa (mín. 16) para assinar o token de login

# Google Ads (só leitura). Sem as 5 primeiras, a seção mostra "conexão pendente".
GOOGLE_ADS_CUSTOMER_ID=               # conta de anúncios da Pádua (10 dígitos), NÃO a da M|P nem a MCC
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=603-989-2603   # MCC pela qual a conta é acessada
GOOGLE_ADS_API_VERSION=               # opcional; padrão v25

# GA4 (só leitura, Data API). Sem as duas, a seção mostra "conexão pendente". Ver DASHBOARD.md → GA4.
GA4_PROPERTY_ID=                      # ID numérico da PROPRIEDADE (Administrador → Detalhes da propriedade). Não é o G-XXXX nem o ID do fluxo
GOOGLE_SERVICE_ACCOUNT_JSON=          # JSON da conta de serviço dashboard-ga4@ (Leitor na propriedade); secreto
